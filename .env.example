# WEB-001 — sanitized environment template
#
# Copy to .env.local for local development. .env* is gitignored except this
# file. Every value below is a placeholder: no real credential is ever
# committed to this repository (SOW section 3).
#
# Where each value actually lives in production is noted against it. Only the
# first one is ever allowed to reach the browser.

# ---------------------------------------------------------------------------
# PUBLIC — compiled into the browser bundle. Safe: it is a public endpoint
# with no key attached.
#
# Production home: GitHub repository VARIABLE (not a secret)
#   Settings > Secrets and variables > Actions > Variables > New variable
#   Name: VITE_CONTACT_ENDPOINT
# ---------------------------------------------------------------------------
VITE_CONTACT_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/functions/v1/contact-submit

# Optional. Only needed when serving a local build under a sub-path. The deploy
# workflow sets this automatically from the repository name.
# VITE_BASE_PATH=/web-001-home-services-demo/

# ---------------------------------------------------------------------------
# PRIVILEGED — never in Git, never in the bundle, never in a screenshot.
# These lines are here to document the names only. Set the real values with
# the commands shown, which store them server-side.
# ---------------------------------------------------------------------------

# Supabase Edge Function secrets
#   supabase secrets set WINDMILL_WEBHOOK_URL=... WINDMILL_TOKEN=... ALLOWED_ORIGIN=...
#
# WINDMILL_WEBHOOK_URL  Synchronous flow endpoint. Shape:
#   https://YOUR_WINDMILL_HOST/api/w/YOUR_WORKSPACE/jobs/run_wait_result/f/web001/contact_intake
# WINDMILL_TOKEN        Windmill token scoped to that one flow. Rotate per docs/HANDOVER.md.
# ALLOWED_ORIGIN        Exact published origin, scheme and host only, no path and no
#                       trailing slash, e.g. https://YOUR_GITHUB_USER.github.io
# WINDMILL_TIMEOUT_MS   Optional, default 20000.
WINDMILL_WEBHOOK_URL=https://YOUR_WINDMILL_HOST/api/w/YOUR_WORKSPACE/jobs/run_wait_result/f/web001/contact_intake
WINDMILL_TOKEN=REPLACE_ME_SCOPED_WINDMILL_TOKEN
ALLOWED_ORIGIN=https://YOUR_GITHUB_USER.github.io
WINDMILL_TIMEOUT_MS=20000

# Windmill resource  f/web001/supabase_admin  (type: supabase)
#   Created in the Windmill UI, not from a file. Fields:
#     url  https://YOUR_PROJECT_REF.supabase.co
#     key  the Supabase service_role key
#   The service_role key bypasses RLS. It exists only inside this Windmill
#   resource. It is not in this repository, not in Supabase Edge secrets, and
#   not in the browser.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVICE_ROLE_KEY_WINDMILL_RESOURCE_ONLY
